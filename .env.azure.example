# ============================================
# GREENCHAINZ AZURE PRODUCTION CONFIGURATION
# ============================================
#
# This file shows the environment variables needed for Azure Container Apps.
# 
# ⚠️  DO NOT COMMIT THIS FILE WITH REAL VALUES!
#
# SECRETS: Set these in Azure Key Vault, NOT here.
# CONFIG:  Set these in Container App environment variables.
#
# See docs/AZURE_SECRETS_AND_CONFIG.md for complete setup guide.
#
# ============================================

# ============================================
# CORE SETTINGS (Container App Environment Variables)
# ============================================

NODE_ENV=production
PORT=3001
LOG_LEVEL=info

# ============================================
# FRONTEND/BACKEND URLs (Container App Environment Variables)
# ============================================

FRONTEND_URL=https://greenchainz.com
BACKEND_URL=https://api.greenchainz.com
COOKIE_DOMAIN=.greenchainz.com

# ⛔ ALL SECRETS MUST BE IN AZURE KEY VAULT — use secretref: not plaintext values
# ============================================
# SECRETS (Azure Key Vault - DO NOT SET HERE)
# ============================================
# These are referenced from Key Vault, not set directly.
# In Azure Container Apps, use Key Vault references:
#
# JWT_SECRET:       secretRef → keyvault → jwt-secret
# SESSION_SECRET:   secretRef → keyvault → session-secret
# COOKIE_SECRET:    secretRef → keyvault → cookie-secret
# DB_PASSWORD:      secretRef → keyvault → postgres-password
# REDIS_PASSWORD:   secretRef → keyvault → redis-password
# AZURE_CLIENT_SECRET: secretRef → keyvault → azure-client-secret
#
# See azure/setup-secrets.sh for Key Vault setup commands.

# ============================================
# AZURE KEY VAULT (Container App Environment Variables)
# ============================================

AZURE_KEY_VAULT_URL=https://greenchainz-vault-2026.vault.azure.net/
AZURE_USE_MANAGED_IDENTITY=true

# User-Assigned Managed Identity Client ID (Production)
# Identity: id-greenchainz-backend (in rg-greenchainz-infra)
# Used by ManagedIdentityCredential in lib/secrets.ts to authenticate to Key Vault.
# Also used by DefaultAzureCredential for authenticating to Azure services
# (Key Vault, Blob Storage, ACR, Document Intelligence, etc.)
# Do NOT set this to the Entra app registration CLIENT_ID — they are different identities.
MANAGED_IDENTITY_CLIENT_ID=ec248abf-f6ce-4d7c-8888-740317709f1b
AZURE_MI_CLIENT_ID=ec248abf-f6ce-4d7c-8888-740317709f1b

# For local development, leave MANAGED_IDENTITY_CLIENT_ID unset to use developer credentials
# (VS Code, Azure CLI, or environment variables)

# ============================================
# POSTGRESQL DATABASE (Container App Environment Variables)
# ============================================
# Password comes from Key Vault reference

POSTGRES_HOST=greenchainz-db.postgres.database.azure.com
POSTGRES_PORT=5432
DB_USER=greenchainz_app
DB_NAME=greenchainz_prod
POSTGRES_SSL=true

# Alternative: Full connection string (if using)
# DATABASE_URL=postgresql://user:password@host:5432/db?sslmode=require

# Connection pool (tune based on your instance size)
PGPOOL_MAX=20
PGPOOL_MIN=5
PGPOOL_IDLE=30000
PGPOOL_CONNECTION_TIMEOUT=10000
PGPOOL_STATEMENT_TIMEOUT=60000

# ============================================
# AZURE AD AUTHENTICATION (Container App Environment Variables)
# ============================================
# Client secret comes from Key Vault reference

AZURE_TENANT_ID=greenchainz2025.onmicrosoft.com

# ── Entra App Registration (USER SIGN-IN ONLY) ────────────────────────────────
# This is the app registration 479e2a01-70ab-4df9-baa4-560d317c3423.
# Used for OAuth2/OIDC user authentication flows only.
# It does NOT grant access to Azure resources.
AZURE_AD_CLIENT_ID=479e2a01-70ab-4df9-baa4-560d317c3423
AZURE_CLIENT_ID=479e2a01-70ab-4df9-baa4-560d317c3423

# Note: MANAGED_IDENTITY_CLIENT_ID (above) = Service-to-service / Azure resource access
#       AZURE_AD_CLIENT_ID                  = User authentication (OAuth2/OIDC) only

# ============================================
# AZURE REDIS CACHE (Container App Environment Variables)
# ============================================
# Password comes from Key Vault reference

REDIS_HOST=greenchainz.redis.cache.windows.net
REDIS_PORT=6380
REDIS_SSL=true

# ============================================
# AZURE BLOB STORAGE (Container App Environment Variables)
# ============================================
# PRODUCTION (Managed Identity - Recommended):
# Only set AZURE_STORAGE_ACCOUNT_NAME - authentication via managed identity
AZURE_STORAGE_ACCOUNT_NAME=greenchainzstorage

# LOCAL DEVELOPMENT (Connection String):
# Use connection string for local dev (comment out in production)
# AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=greenchainzstorage;AccountKey=YOUR_KEY;EndpointSuffix=core.windows.net

AZURE_STORAGE_CONTAINER_NAME=greenchainz-uploads

# ============================================
# AZURE SQL DATABASE (Products, Suppliers, Users)
# ============================================

AZURE_SQL_SERVER=greenchainz.database.windows.net
AZURE_SQL_DATABASE=greenchainz_prod
AZURE_SQL_USER=greenchainzadmin
# Password from Key Vault reference

# ============================================
# AZURE AI SERVICES (Container App Environment Variables)
# ============================================
# API key comes from Key Vault reference

# Document Intelligence (uses managed identity - no key required)
DOCUMENT_INTELLIGENCE_ENDPOINT=https://greenchainz-content-intel.cognitiveservices.azure.com/
AZURE_OPENAI_ENDPOINT=https://greenchainz-openai.openai.azure.com/
AZURE_OPENAI_API_KEY=secretref:openai-key
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini

# ============================================
# AZURE COSMOS DB (Container App Environment Variables)
# ============================================
# Connection string from Key Vault reference
# Used by persona-scraper function for scraping rules

COSMOS_CONNECTION_STRING=secretref:cosmos-connection-string
COSMOS_DATABASE_NAME=greenchainz
COSMOS_CONTAINER_NAME=ScrapingRules

# ============================================
# AZURE BING SEARCH API (Function App Environment Variables)
# ============================================
# Used by gatekeeper-discovery function for lead hunting

BING_SEARCH_API_KEY=secretref:bing-search-api-key
BING_SEARCH_ENDPOINT=https://api.bing.microsoft.com/v7.0/search

# Note: Azure OpenAI is used by gatekeeper-discovery for GPT-4o qualification
# Deployment should be gpt-4o (not gpt-4o-mini) for better lead qualification
# Update AZURE_OPENAI_DEPLOYMENT in production if using gatekeeper-discovery

# ============================================
# AZURE MONITORING (Container App Environment Variables)
# ============================================
# Connection string from Key Vault reference (contains key)

# APPLICATIONINSIGHTS_CONNECTION_STRING via Key Vault

# ============================================
# EMAIL CONFIGURATION (Container App Environment Variables)
# ============================================
# RESEND (primary transactional email — buyer-drip + outreach notifications)
# Get your key at https://resend.com → API Keys
# Store in Key Vault as: resend-api-key
# Domain greenchainz.com must be verified in Resend dashboard before use.
RESEND_API_KEY=secretref:resend-api-key
RESEND_FROM_EMAIL=noreply@greenchainz.com

# SMTP (fallback / legacy — Zoho)
NOTIFICATIONS_ENABLED=true
SMTP_HOST=smtp.zoho.com
SMTP_PORT=465
SMTP_USER=noreply@greenchainz.com
SMTP_FROM_EMAIL=noreply@greenchainz.com
SMTP_FROM_NAME=GreenChainz
ADMIN_EMAIL=admin@greenchainz.com

# ============================================
# FRED ECONOMIC DATA API
# ============================================
# Used by fred-scraper to pull PPI series (e.g. PCU32411324 — Plastics)
# Free API key: https://fred.stlouisfed.org/docs/api/api_key.html
# Store in Key Vault as: fred-api-key
FRED_API_KEY=secretref:fred-api-key

# ============================================
# FEATURE FLAGS (Container App Environment Variables)
# ============================================

FEATURE_AZURE_MONITORING=true
FEATURE_REDIS_CACHING=true
FEATURE_AI_DOCUMENT_ANALYSIS=true

# ============================================
# KEY VAULT SECRET NAMES REFERENCE
# ============================================
# Use these names when storing secrets in Key Vault:
#
# jwt-secret              → JWT_SECRET
# session-secret          → SESSION_SECRET
# cookie-secret           → COOKIE_SECRET
# postgres-password       → DB_PASSWORD
# redis-password          → REDIS_PASSWORD
# azure-client-secret     → AZURE_CLIENT_SECRET
# openai-key              → AZURE_OPENAI_KEY
# smtp-password           → SMTP_PASS
# resend-api-key          → RESEND_API_KEY
# fred-api-key            → FRED_API_KEY
# appinsights-connection  → APPLICATIONINSIGHTS_CONNECTION_STRING
# internal-api-key        → INTERNAL_API_KEY
#
# NOTE: Document Intelligence uses managed identity (no key needed)

# ============================================
# CONTAINER APP SECRETS CONFIGURATION
# ============================================
# In Azure Portal → Container App → Secrets, add:
#
# Name                    | Source      | Key Vault Secret URI
# ----------------------- | ----------- | ------------------------------------
# jwt-secret              | Key Vault   | https://vault.../secrets/jwt-secret
# session-secret          | Key Vault   | https://vault.../secrets/session-secret
# cookie-secret           | Key Vault   | https://vault.../secrets/cookie-secret
# postgres-password       | Key Vault   | https://vault.../secrets/postgres-password
# redis-password          | Key Vault   | https://vault.../secrets/redis-password
# azure-client-secret     | Key Vault   | https://vault.../secrets/azure-client-secret
# resend-api-key          | Key Vault   | https://vault.../secrets/resend-api-key
# fred-api-key            | Key Vault   | https://vault.../secrets/fred-api-key
#
# Then in Environment Variables, reference them:
#
# Name            | Value
# --------------- | -----------------
# JWT_SECRET      | secretref:jwt-secret
# SESSION_SECRET  | secretref:session-secret
# RESEND_API_KEY  | secretref:resend-api-key
# FRED_API_KEY    | secretref:fred-api-key
# ============================================
# AZURE AD AUTHENTICATION
# ============================================
# GreenChainz uses centralized JWT session cookies (app_session_id).
# Azure Easy Auth is NOT used. See AUTH_GUARDRAILS.md.
