/**
 * Category Baseline Service
 *
 * Computes median GWP per assembly category.
 * Used for carbon scoring to compare a material against its category baseline.
 */

import { getDb } from "../db";
import { epdMaterials } from "../../drizzle/schema";
import { eq, isNotNull } from "drizzle-orm";

/**
 * In-memory cache of category baselines
 */
const baselineCache = new Map<string, number>();

const DEFAULT_BASELINE = 10000;

function calculateMedian(values: number[]): number {
  if (values.length === 0) return DEFAULT_BASELINE;

  // Sort numerically
  values.sort((a, b) => a - b);

  const half = Math.floor(values.length / 2);
  if (values.length % 2 !== 0) {
    return values[half]!;
  }

  return (values[half - 1]! + values[half]!) / 2.0;
}

/**
 * Computes and returns the median GWP per assembly type.
 * Pulls from the epd_materials table and ignores NULLs.
 * Uses an in-memory Map for caching.
 * @param assemblyType The target assembly category (e.g. 'EWS-1A')
 */
export async function getCategoryBaseline(assemblyType: string): Promise<number> {
  if (baselineCache.has(assemblyType)) {
    return baselineCache.get(assemblyType)!;
  }

  const db = await getDb();
  if (!db) {
    return DEFAULT_BASELINE; // Fallback if DB unavailable
  }

  // Query all materials in this category
  const records = await db
    .select({
      gwpPer1000sf: epdMaterials.gwpPer1000sf,
    })
    .from(epdMaterials)
    .where(eq(epdMaterials.assemblyType, assemblyType));

  const validGwpValues: number[] = [];
  for (const record of records) {
    if (record.gwpPer1000sf !== null) {
      const parsed =
        typeof record.gwpPer1000sf === "string"
          ? parseFloat(record.gwpPer1000sf)
          : parseFloat(String(record.gwpPer1000sf));
      if (!isNaN(parsed)) {
        validGwpValues.push(parsed);
      }
    }
  }

  const median = calculateMedian(validGwpValues);
  baselineCache.set(assemblyType, median);
  return median;
}

/**
 * Computes baselines for all assembly types found in the database.
 * Updates the local cache in the process.
 * @returns A map of assemblyType to its median GWP
 */
export async function computeAllBaselines(): Promise<Record<string, number>> {
  const db = await getDb();
  if (!db) {
    return {};
  }

  const records = await db
    .select({
      assemblyType: epdMaterials.assemblyType,
      gwpPer1000sf: epdMaterials.gwpPer1000sf,
    })
    .from(epdMaterials)
    .where(isNotNull(epdMaterials.assemblyType));

  const groupedValues = new Map<string, number[]>();

  for (const record of records) {
    const at = record.assemblyType;
    if (!at) continue;

    if (record.gwpPer1000sf !== null) {
      const parsed =
        typeof record.gwpPer1000sf === "string"
          ? parseFloat(record.gwpPer1000sf)
          : parseFloat(String(record.gwpPer1000sf));
      if (!isNaN(parsed)) {
        if (!groupedValues.has(at)) {
          groupedValues.set(at, []);
        }
        groupedValues.get(at)!.push(parsed);
      }
    }
  }

  const result: Record<string, number> = {};
  for (const [at, values] of groupedValues.entries()) {
    const median = calculateMedian(values);
    result[at] = median;
    baselineCache.set(at, median);
  }

  return result;
}
