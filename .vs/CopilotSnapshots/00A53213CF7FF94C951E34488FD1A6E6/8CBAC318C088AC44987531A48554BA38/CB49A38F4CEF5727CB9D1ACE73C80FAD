/**
 * Category Baseline Service
 *
 * Computes median GWP and average price per assembly category.
 * Used by CCPS scorer to normalize materials against their category baseline.
 */

import { getDb } from "../db";
import { epdMaterials } from "../../drizzle/schema";
import { eq } from "drizzle-orm";

interface CategoryBaseline {
  gwp: number; // Median GWP per 1000 SF
  price: number; // Average price per unit
}

/**
 * In-memory cache of category baselines
 * TTL: 1 hour (in production, consider Redis)
 */
const baselineCache = new Map<
  string,
  { baseline: CategoryBaseline; timestamp: number }
>();

const CACHE_TTL = 3600 * 1000; // 1 hour in ms

/**
 * Get or compute category baseline (GWP + price)
 * Cached to avoid recomputation
 */
export async function getCategoryBaseline(
  assemblyType: string,
): Promise<CategoryBaseline> {
  // Check cache
  const cached = baselineCache.get(assemblyType);
  if (cached && Date.now() - cached.timestamp < CACHE_TTL) {
    return cached.baseline;
  }

  const db = await getDb();
  if (!db) {
    // Fallback if DB unavailable
    return { gwp: 10000, price: 100 };
  }

  // Query all materials in this category
  const materials = await db
    .select({
      gwp: epdMaterials.gwpPer1000sf,
      price: epdMaterials.pricePerUnit,
    })
    .from(epdMaterials)
    .where(eq(epdMaterials.assemblyType, assemblyType));

  // Filter out NULLs
  const gwpValues = materials
    .map((m) => (m.gwp ? parseFloat(m.gwp.toString()) : null))
    .filter((v): v is number => v !== null)
    .sort((a, b) => a - b);

  const priceValues = materials
    .map((m) => (m.price ? parseFloat(m.price.toString()) : null))
    .filter((v): v is number => v !== null);

  // Compute median GWP
  let medianGwp = 10000; // Fallback default
  if (gwpValues.length > 0) {
    const mid = Math.floor(gwpValues.length / 2);
    medianGwp =
      gwpValues.length % 2 !== 0
        ? gwpValues[mid]
        : (gwpValues[mid - 1] + gwpValues[mid]) / 2;
  }

  // Compute average price
  let avgPrice = 100; // Fallback default
  if (priceValues.length > 0) {
    avgPrice = priceValues.reduce((a, b) => a + b, 0) / priceValues.length;
  }

  const baseline: CategoryBaseline = {
    gwp: medianGwp,
    price: avgPrice,
  };

  // Cache it
  baselineCache.set(assemblyType, { baseline, timestamp: Date.now() });

  return baseline;
}

/**
 * Compute baselines for all assembly types
 * Useful for seeding or warming the cache
 */
export async function computeAllBaselines(): Promise<
  Record<string, CategoryBaseline>
> {
  const db = await getDb();
  if (!db) {
    return {};
  }

  // Get all distinct assembly types
  const assemblyTypes = [
    "EWS-1A",
    "EWS-1B",
    "EWS-2A",
    "EWS-2B",
    "EWS-3A",
    "EWS-3B",
    "EWS-3C",
    "EWS-5",
  ];

  const result: Record<string, CategoryBaseline> = {};

  await Promise.all(
    assemblyTypes.map(async (type) => {
      result[type] = await getCategoryBaseline(type);
    }),
  );

  return result;
}

/**
 * Clear cache (useful for testing or forcing recomputation)
 */
export function clearBaselineCache(): void {
  baselineCache.clear();
}
