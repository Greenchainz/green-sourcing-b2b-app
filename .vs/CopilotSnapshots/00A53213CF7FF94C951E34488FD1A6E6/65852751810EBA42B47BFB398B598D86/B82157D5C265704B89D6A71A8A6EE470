"use client";

import { useEffect, useState } from "react";
import { useRouter, useParams } from "next/navigation";
import { toast } from "sonner";
import { trpc } from "@/lib/trpc";
import { Button } from "@/components/ui/button";
import { Card, CardContent, CardDescription, CardHeader, CardTitle } from "@/components/ui/card";
import { Badge } from "@/components/ui/badge";
import { Skeleton } from "@/components/ui/skeleton";
import { AlertCircle, CheckCircle2, Loader2, ArrowLeft, Search } from "lucide-react";

export default function SpecResultsPage() {
  const router = useRouter();
  const params = useParams();
  const specId = parseInt(params.specId as string);

  const [selectedPersona, setSelectedPersona] = useState<
    "aor" | "leed_ap" | "gc_pm" | "spec_writer" | "interior_designer"
  >("aor");
  const [topN, setTopN] = useState(5);

  const getSpecQuery = trpc.architectSpec.getSpec.useQuery(
    { specId },
    { enabled: !!specId }
  );

  const matchAlternativesMutation = trpc.architectSpec.matchAlternatives.useMutation();

  const handleRunMatch = async () => {
    try {
      toast.promise(
        matchAlternativesMutation.mutateAsync({
          specId,
          topN,
          persona: selectedPersona,
        }),
        {
          loading: "Running material matching algorithm...",
          success: "Alternatives found! Refreshing page...",
          error: "Failed to find alternatives",
        }
      );

      await matchAlternativesMutation.mutateAsync({
        specId,
        topN,
        persona: selectedPersona,
      });

      // Refresh spec data
      await getSpecQuery.refetch();
    } catch (error) {
      console.error("Match error:", error);
    }
  };

  if (getSpecQuery.isLoading) {
    return (
      <div className="min-h-screen bg-gray-50 py-12 px-4">
        <div className="max-w-4xl mx-auto space-y-4">
          <Skeleton className="h-8 w-32" />
          <Skeleton className="h-48 w-full" />
          <Skeleton className="h-48 w-full" />
        </div>
      </div>
    );
  }

  if (getSpecQuery.isError || !getSpecQuery.data) {
    return (
      <div className="min-h-screen bg-gray-50 py-12 px-4">
        <div className="max-w-4xl mx-auto">
          <Button variant="outline" onClick={() => router.back()} className="mb-6">
            <ArrowLeft className="h-4 w-4 mr-2" />
            Back
          </Button>
          <Card className="border-red-200 bg-red-50">
            <CardContent className="pt-6 flex items-center gap-3">
              <AlertCircle className="h-5 w-5 text-red-600" />
              <div>
                <p className="font-semibold text-red-900">Spec not found</p>
                <p className="text-sm text-red-700">The specification you're looking for doesn't exist or you don't have access to it.</p>
              </div>
            </CardContent>
          </Card>
        </div>
      </div>
    );
  }

  const { spec, assemblies } = getSpecQuery.data;

  return (
    <div className="min-h-screen bg-gray-50 py-12 px-4">
      <div className="max-w-4xl mx-auto space-y-6">
        {/* Header */}
        <div>
          <Button variant="outline" onClick={() => router.back()} className="mb-4">
            <ArrowLeft className="h-4 w-4 mr-2" />
            Back
          </Button>
          <h1 className="text-3xl font-bold text-gray-900">{spec.originalFilename}</h1>
          <p className="text-gray-600 mt-2">
            Uploaded {new Date(spec.createdAt).toLocaleDateString()}
          </p>
        </div>

        {/* Spec Overview Card */}
        <Card>
          <CardHeader>
            <CardTitle>Project Details</CardTitle>
          </CardHeader>
          <CardContent className="space-y-4">
            {spec.projectName && (
              <div>
                <p className="text-sm font-medium text-gray-700">Project Name</p>
                <p className="text-gray-900">{spec.projectName}</p>
              </div>
            )}
            {spec.projectLocation && (
              <div>
                <p className="text-sm font-medium text-gray-700">Location</p>
                <p className="text-gray-900">{spec.projectLocation}</p>
              </div>
            )}
            {spec.estimatedValue && (
              <div>
                <p className="text-sm font-medium text-gray-700">Estimated Material Value</p>
                <p className="text-gray-900">${spec.estimatedValue.toLocaleString()}</p>
              </div>
            )}
            <div>
              <p className="text-sm font-medium text-gray-700">Parse Status</p>
              <div className="flex items-center gap-2 mt-1">
                {spec.parseStatus === "ready" && (
                  <>
                    <CheckCircle2 className="h-4 w-4 text-green-600" />
                    <span className="text-green-700 font-medium">Ready</span>
                  </>
                )}
                {spec.parseStatus === "processing" && (
                  <>
                    <Loader2 className="h-4 w-4 text-blue-600 animate-spin" />
                    <span className="text-blue-700 font-medium">Processing</span>
                  </>
                )}
                {spec.parseStatus === "failed" && (
                  <>
                    <AlertCircle className="h-4 w-4 text-red-600" />
                    <span className="text-red-700 font-medium">Failed</span>
                  </>
                )}
              </div>
            </div>
          </CardContent>
        </Card>

        {/* Match Options */}
        {spec.parseStatus === "ready" && (
          <Card>
            <CardHeader>
              <CardTitle>Find Sustainable Alternatives</CardTitle>
              <CardDescription>Configure the material matching algorithm</CardDescription>
            </CardHeader>
            <CardContent className="space-y-6">
              <div>
                <label className="block text-sm font-medium text-gray-700 mb-3">Architect Persona</label>
                <div className="grid grid-cols-2 md:grid-cols-5 gap-2">
                  {(
                    [
                      { value: "aor" as const, label: "AOR" },
                      { value: "leed_ap" as const, label: "LEED AP" },
                      { value: "gc_pm" as const, label: "GC/PM" },
                      { value: "spec_writer" as const, label: "Spec Writer" },
                      { value: "interior_designer" as const, label: "Interior" },
                    ] as const
                  ).map((persona) => (
                    <button
                      key={persona.value}
                      onClick={() => setSelectedPersona(persona.value)}
                      className={`px-3 py-2 rounded-lg text-sm font-medium transition ${
                        selectedPersona === persona.value
                          ? "bg-green-600 text-white"
                          : "bg-gray-200 text-gray-700 hover:bg-gray-300"
                      }`}
                    >
                      {persona.label}
                    </button>
                  ))}
                </div>
              </div>

              <div>
                <label htmlFor="topN" className="block text-sm font-medium text-gray-700 mb-2">
                  Top Results Per Row: {topN}
                </label>
                <input
                  id="topN"
                  type="range"
                  min="1"
                  max="20"
                  value={topN}
                  onChange={(e) => setTopN(parseInt(e.target.value))}
                  className="w-full"
                />
              </div>

              <Button
                onClick={handleRunMatch}
                disabled={matchAlternativesMutation.isPending}
                className="w-full bg-green-600 hover:bg-green-700"
              >
                {matchAlternativesMutation.isPending ? (
                  <>
                    <Loader2 className="h-4 w-4 mr-2 animate-spin" />
                    Matching Materials...
                  </>
                ) : (
                  "Run Material Matcher"
                )}
              </Button>
            </CardContent>
          </Card>
        )}

        {/* Parsed Assemblies */}
        <div>
          <h2 className="text-xl font-bold text-gray-900 mb-4">
            Parsed Assemblies {spec.parseStatus !== "failed" && `(${assemblies.length})`}
          </h2>
          
          {spec.parseStatus === "failed" ? (
            <Card className="border-red-200 bg-red-50">
              <CardContent className="pt-8 pb-8 text-center flex flex-col items-center justify-center">
                <AlertCircle className="h-12 w-12 text-red-500 mb-4" />
                <h3 className="text-lg font-semibold text-red-900 mb-2">Failed to parse spec</h3>
                <p className="text-red-700 mb-6 max-w-sm">
                  We couldn't extract materials from your PDF. Try uploading a different file or check the format.
                </p>
                <Button 
                  onClick={() => router.push("/architect/specs/upload")}
                  className="bg-red-600 hover:bg-red-700 min-h-[44px]"
                >
                  Try Again
                </Button>
              </CardContent>
            </Card>
          ) : matchAlternativesMutation.isPending ? (
            <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
              {[...Array(5)].map((_, i) => (
                <Skeleton key={i} className="h-32 w-full rounded-xl" />
              ))}
            </div>
          ) : (
            <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
              {assemblies.map((assembly) => {
                const hasRunMatcher = matchAlternativesMutation.isSuccess;
                const hasNoMatch = hasRunMatcher && !assembly.matchedEpdMaterialId;
                
                return (
                <Card key={assembly.id} className="flex flex-col">
                  <CardHeader>
                    <div className="flex items-start justify-between">
                      <div>
                        <CardTitle className="text-lg">
                          {assembly.assemblyCode || "Unclassified"}
                        </CardTitle>
                        <CardDescription>{assembly.assemblyType}</CardDescription>
                      </div>
                      {assembly.matchedEpdMaterialId && (
                        <Badge className="bg-green-100 text-green-800">
                          ✓ Matched
                        </Badge>
                      )}
                    </div>
                  </CardHeader>
                  <CardContent className="space-y-3 flex-1 flex flex-col">
                    <div className="grid grid-cols-2 gap-4">
                      <div>
                        <p className="text-xs font-medium text-gray-600">Original GWP</p>
                        <p className="text-sm text-gray-900">
                          {assembly.gwpPer1000sf
                            ? `${parseFloat(assembly.gwpPer1000sf.toString()).toFixed(2)} kgCO₂e/1000sf`
                            : "Not specified"}
                        </p>
                      </div>
                      <div>
                        <p className="text-xs font-medium text-gray-600">Structural Option</p>
                        <p className="text-sm text-gray-900">{assembly.structuralOption || "Default"}</p>
                      </div>
                    </div>

                    {assembly.matchConfidence && (
                      <div>
                        <p className="text-xs font-medium text-gray-600 mb-2">Match Confidence</p>
                        <div className="flex items-center gap-2">
                          <div className="flex-1 bg-gray-200 rounded-full h-2">
                            <div
                              className="bg-green-500 h-2 rounded-full"
                              style={{
                                width: `${Math.min(
                                  parseFloat(assembly.matchConfidence.toString()) * 100,
                                  100
                                )}%`,
                              }}
                            />
                          </div>
                          <span className="text-xs font-semibold text-gray-700">
                            {(parseFloat(assembly.matchConfidence.toString()) * 100).toFixed(0)}%
                          </span>
                        </div>
                      </div>
                    )}
                    
                    {hasNoMatch && (
                      <div className="mt-auto pt-4 border-t border-gray-100 flex flex-col items-center text-center">
                        <Search className="h-6 w-6 text-gray-400 mb-2" />
                        <p className="text-sm font-semibold text-gray-900 mb-1">No alternatives found</p>
                        <p className="text-xs text-gray-500">
                          We couldn't find materials matching your constraints for this assembly.<br/>
                          Try adjusting your persona or filters.
                        </p>
                      </div>
                    )}
                  </CardContent>
                </Card>
              )})}
            </div>
          )}
        </div>
      </div>
    </div>
  );
}
