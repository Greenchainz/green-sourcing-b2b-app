# ============================================
# GREENCHAINZ LOCAL DEVELOPMENT — .env.local.example
# ============================================
# Copy this to .env and fill in real values.
# NEVER commit .env with real secrets.
#
# ⚠️  RULE: OAUTH_SERVER_URL must be in .env, NOT .env.local
#           (Easy Auth sidecar reads .env only)
# ============================================

NODE_ENV=development
PORT=3001
LOG_LEVEL=debug

# ─── Frontend / Backend URLs ────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:3001
COOKIE_DOMAIN=localhost

# ─── PostgreSQL ─────────────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=greenchainz_dev
POSTGRES_SSL=false
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/greenchainz_dev

# ─── Auth ───────────────────────────────────────────────────────────────────
# Must be in .env (not .env.local) for Easy Auth shim to work in dev
OAUTH_SERVER_URL=https://login.microsoftonline.com/1d04bf50-8175-40af-a9d5-f8e441460b06/v2.0
AZURE_AD_CLIENT_ID=8b597068-9347-4e99-8860-8c4e9a9bc112
AZURE_CLIENT_ID=8b597068-9347-4e99-8860-8c4e9a9bc112
AZURE_TENANT_ID=1d04bf50-8175-40af-a9d5-f8e441460b06
# AZURE_AD_CLIENT_SECRET — get from Azure Portal → App Registrations → greenchainz-app → Certificates & secrets
AZURE_AD_CLIENT_SECRET=your_client_secret_here

JWT_SECRET=dev_jwt_secret_change_in_prod
SESSION_SECRET=dev_session_secret_change_in_prod
COOKIE_SECRET=dev_cookie_secret_change_in_prod

# ─── FRED Economic Data ─────────────────────────────────────────────────────
# Required by fred-scraper (PCU32411324 and other PPI series)
# Free key: https://fred.stlouisfed.org/docs/api/api_key.html → Request API Key
FRED_API_KEY=your_fred_api_key_here

# ─── Email (Resend) ─────────────────────────────────────────────────────────
# Required by buyer-drip scheduler and outreach notifications
# Free key: https://resend.com → API Keys → Create
# Use onboarding@resend.dev as RESEND_FROM_EMAIL until greenchainz.com domain is verified in Resend
RESEND_API_KEY=re_your_key_here
RESEND_FROM_EMAIL=onboarding@resend.dev

# ─── Azure OpenAI ───────────────────────────────────────────────────────────
AZURE_OPENAI_ENDPOINT=https://greenchainz-openai.openai.azure.com/
AZURE_OPENAI_API_KEY=your_openai_key_here
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini

# ─── Azure Blob Storage (local dev uses connection string) ──────────────────
# AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=greencontent;AccountKey=YOUR_KEY;EndpointSuffix=core.windows.net
AZURE_STORAGE_ACCOUNT_NAME=greencontent
AZURE_STORAGE_CONTAINER_NAME=greenchainz-uploads

# ─── Feature Flags ──────────────────────────────────────────────────────────
FEATURE_AZURE_MONITORING=false
FEATURE_REDIS_CACHING=false
FEATURE_AI_DOCUMENT_ANALYSIS=true

# ─── Admin ──────────────────────────────────────────────────────────────────
ADMIN_EMAIL=admin@greenchainz.com
NOTIFICATIONS_ENABLED=true
