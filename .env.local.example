# ============================================
# LOCAL DEVELOPMENT ENVIRONMENT VARIABLES
# ============================================
#
# Copy this file to .env.local and fill in your actual values
# cp .env.local.example .env.local
#
# ⚠️  DO NOT COMMIT .env.local - it should be in .gitignore
#
# ============================================

# ============================================
# AZURE EASY AUTH (Local Development)
# ============================================

# For local development, Easy Auth headers are not available
# Use test/mock headers or run the app through Azure Container Apps dev container
# See docs/EASY_AUTH_INTEGRATION.md for local testing strategies

# Optional: Azure AD credentials for local testing
AZURE_AD_CLIENT_ID=your_azure_ad_app_client_id
AZURE_AD_CLIENT_SECRET=your_azure_ad_client_secret
AZURE_AD_TENANT_ID=your-tenant-id

# ============================================
# DATABASE (Local Development)
# ============================================

# Option A — connection string (simplest)
DATABASE_URL=postgresql://USERNAME:PASSWORD@YOUR-SERVER.postgres.database.azure.com:5432/DBNAME?sslmode=require

# Option B — individual Azure Service Connector variables (alternative to DATABASE_URL)
# Uncomment and fill in if you prefer individual vars instead of DATABASE_URL
# AZURE_POSTGRESQL_HOST=your-server.postgres.database.azure.com
# AZURE_POSTGRESQL_PORT=5432
# AZURE_POSTGRESQL_DATABASE=greenchainz
# AZURE_POSTGRESQL_USER=your-admin-user
# AZURE_POSTGRESQL_PASSWORD=your-password

# ============================================
# OPTIONAL: Additional Configuration
# ============================================

# Node environment
NODE_ENV=development

# Backend URL (if using separate backend)
BACKEND_URL=http://localhost:3001
