# Frontend container image for GreenChainz on Azure Container Apps
# Builds frontend assets and runs the app server for frontend traffic.

# Stage 1: Dependencies
FROM dhi.io/node:22-debian13-dev AS deps
WORKDIR /app
RUN corepack enable && corepack prepare pnpm@10.28.2 --activate
# Install dumb-init for proper signal handling (copied to runtime below)
RUN apt-get update && apt-get install -y --no-install-recommends dumb-init && rm -rf /var/lib/apt/lists/*
COPY package.json pnpm-lock.yaml ./
COPY patches/ ./patches/
RUN pnpm install --frozen-lockfile

# Stage 2: Builder
FROM dhi.io/node:22-debian13-dev AS builder
WORKDIR /app
RUN corepack enable && corepack prepare pnpm@10.28.2 --activate
COPY --from=deps /app/node_modules ./node_modules
COPY . .
ARG VITE_FRONTEND_WEBPUBSUB_ENDPOINT=https://greenchainz.webpubsub.azure.com
ARG VITE_FRONTEND_WEBPUBSUB_HUB=greenchainzhub
ARG VITE_AZURE_MAPS_KEY
ARG VITE_BACKEND_URL
ARG VITE_SENTRY_DSN
ARG SENTRY_AUTH_TOKEN
ARG SENTRY_ORG
ARG SENTRY_PROJECT
ENV VITE_FRONTEND_WEBPUBSUB_ENDPOINT=$VITE_FRONTEND_WEBPUBSUB_ENDPOINT \
    VITE_FRONTEND_WEBPUBSUB_HUB=$VITE_FRONTEND_WEBPUBSUB_HUB \
    VITE_BACKEND_URL=$VITE_BACKEND_URL \
    NODE_ENV=production
RUN VITE_AZURE_MAPS_KEY=$VITE_AZURE_MAPS_KEY \
    VITE_SENTRY_DSN=$VITE_SENTRY_DSN \
    SENTRY_AUTH_TOKEN=$SENTRY_AUTH_TOKEN \
    SENTRY_ORG=$SENTRY_ORG \
    SENTRY_PROJECT=$SENTRY_PROJECT \
    pnpm run build

# Stage 3: Runtime — DHI minimal image (no shell, no package manager, zero CVEs)
FROM dhi.io/node:22-debian13 AS runtime
WORKDIR /app
# Copy dumb-init binary from deps stage (runtime image has no package manager)
COPY --from=deps /usr/bin/dumb-init /usr/bin/dumb-init
# DHI runtime runs as non-root user 'node' (uid 1000) — no adduser step needed
COPY --from=builder --chown=node:node /app/dist ./dist
COPY --from=builder --chown=node:node /app/node_modules ./node_modules
COPY --from=builder --chown=node:node /app/public ./public
COPY --from=builder --chown=node:node /app/package.json ./package.json
USER node
ENV NODE_ENV=production \
    PORT=3000 \
    NODE_PG_FORCE_NATIVE=""
# Health check — exec form required (no shell in DHI minimal runtime)
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD ["node", "-e", "const port = process.env.PORT || 3000; require('http').get('http://localhost:' + port + '/healthz', (r) => {if (r.statusCode !== 200) throw new Error(r.statusCode)})"]
EXPOSE 3000
ENTRYPOINT ["/usr/bin/dumb-init", "--"]
CMD ["node", "dist/index.js"]
