  "scripts": {
    "dev": "cross-env NODE_ENV=development tsx watch server/_core/index.ts",
    "build": "vite build && esbuild server/_core/index.ts --platform=node --packages=external --bundle --format=esm --outdir=dist",
    "start": "cross-env NODE_ENV=production node dist/index.js",
    "check": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:chromium": "playwright test --project=chromium",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:migrate": "drizzle-kit migrate",
    "db:indexes": "tsx scripts/run-concurrent-indexes.ts",
    "db:studio": "drizzle-kit studio",
    "seed:ews": "tsx scripts/seed-ews-assemblies.ts",
    "seed:suppliers": "tsx scripts/seed-suppliers.ts",
    "lint": "eslint \"server/**/*.ts\" \"client/src/**/*.{ts,tsx}\" \"lib/**/*.ts\"",
    "lint:fix": "eslint \"server/**/*.ts\" \"client/src/**/*.{ts,tsx}\" \"lib/**/*.ts\" --fix",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "verify": "pnpm typecheck && pnpm lint && pnpm test && pnpm build"
  },
