DATABASE_URL="your_database_connection_string_here"

# Better Auth (session signing)
# Production: loaded from Key Vault secret "AUTH-SECRET" → AUTH_SECRET
# Local: generate with `openssl rand -base64 32`
AUTH_SECRET="your_super_secret_auth_secret_here"

# ── Entra App Registration (USER SIGN-IN ONLY — OAuth2 / OIDC flows) ──────────
# This is the app registration 8b597068-9347-4e99-8860-8c4e9a9bc112.
# It does NOT grant access to Azure resources. It is used for user authentication only.
# Production: loaded from Key Vault secrets "AZURE-AD-CLIENT-ID" / "AZURE-AD-CLIENT-SECRET" / "AZURE-AD-TENANT-ID"
AZURE_AD_CLIENT_ID="8b597068-9347-4e99-8860-8c4e9a9bc112"
AZURE_CLIENT_ID="8b597068-9347-4e99-8860-8c4e9a9bc112"
AZURE_AD_CLIENT_SECRET="your_azure_ad_client_secret_here"
AZURE_CLIENT_SECRET="your_azure_ad_client_secret_here"
AZURE_AD_TENANT_ID="1d04bf50-8175-40af-a9d5-f8e441460b06"
AZURE_TENANT_ID="1d04bf50-8175-40af-a9d5-f8e441460b06"

# ── Easy Auth validation (Azure Container Apps Easy Auth / App Service Auth) ──
# Used by middleware/parseAuth.js when validating x-ms-client-principal.
# NOTE: These are NOT secrets; they are the expected tenant/app IDs for inbound auth.
AAD_TENANT_ID="ca4f78d4-c753-4893-9cd8-1b309922b4dc"
AAD_CLIENT_ID="479e2a01-70ab-4df9-baa4-560d317c3423"

# ── User-Assigned Managed Identity (AZURE RESOURCE ACCESS ONLY) ───────────────
# This is the user-assigned managed identity id-greenchainz-backend.
# It is NOT the same as the Entra app registration above.
# Used by ManagedIdentityCredential in lib/secrets.ts to authenticate to Key Vault.
# Production: set in Container App environment variables (NOT a secret).
# Local dev: leave unset to fall back to VS Code / Azure CLI credentials.
MANAGED_IDENTITY_CLIENT_ID="ec248abf-f6ce-4d7c-8888-740317709f1b"
AZURE_MI_CLIENT_ID="ec248abf-f6ce-4d7c-8888-740317709f1b"

# ── OAuth Server (Manus OAuth service) ────────────────────────────────────────
# Base URL for the Manus OAuth service (ExchangeToken / GetUserInfo).
# MUST be set in .env — do NOT put this only in .env.local.
OAUTH_SERVER_URL="https://your-oauth-server-url-here"

# App URL (must match your site for better-auth callbacks)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ── Azure Communication Services ──────────────────────────────────────────────
# Endpoint OR connection string — prefer endpoint + managed identity in prod.
AZURE_COMMUNICATION_SERVICES_ENDPOINT="https://communication-green.unitedstates.communication.azure.com"
# For local dev only (not for prod):
# AZURE_COMMUNICATION_SERVICES_CONNECTION_STRING="endpoint=https://...;accesskey=..."

# Phone numbers provisioned in communication-green ACS resource
# Local US number — used as caller-ID for outbound TTS/voice calls
ACS_LOCAL_NUMBER="+14175014967"
# Toll-free US number — used as sender for SMS marketing blasts
ACS_TOLL_FREE_NUMBER="+18333236128"
# Missed in-app call forwarding alert destination (fallback default in code: +14343592460)
MISSED_CALL_FORWARD_PHONE="+1XXXXXXXXXX"

# Base URL for ACS call-event webhook callbacks (must be publicly reachable HTTPS)
# Production: https://greenchainz.com
# Local dev: use ngrok — e.g. https://abc123.ngrok.io
APP_BASE_URL="https://greenchainz.com"

# Shared secret for ACS webhook callback validation. This token is appended to
# the callback URI for outbound TTS calls and verified by /api/acs/call-events.
ACS_CALLBACK_AUTH_SECRET="replace-with-long-random-secret"
