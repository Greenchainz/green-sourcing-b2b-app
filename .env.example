DATABASE_URL="your_database_connection_string_here"

# Better Auth (session signing)
# Production: loaded from Key Vault secret "AUTH-SECRET" → AUTH_SECRET
# Local: generate with `openssl rand -base64 32`
AUTH_SECRET="your_super_secret_auth_secret_here"

# Google OAuth
# Production: loaded from Key Vault secrets "GOOGLE-CLIENTID" / "GOOGLE-SECRET"
GOOGLE_CLIENT_ID="your_google_client_id_here"
GOOGLE_CLIENT_SECRET="your_google_client_secret_here"

# Microsoft Entra ID (for user login AND Marketplace API)
# Production: loaded from Key Vault secrets "AZURE-AD-CLIENT-ID" / "AZURE-AD-CLIENT-SECRET" / "AZURE-AD-TENANT-ID"
# Local dev uses AZURE_CLIENT_ID / AZURE_CLIENT_SECRET / AZURE_TENANT_ID (shorter names)
AZURE_CLIENT_ID="479e2a01-70ab-4df9-baa4-560d317c3423"
AZURE_CLIENT_SECRET="your_azure_ad_client_secret_here"
AZURE_TENANT_ID="ca4f78d4-c753-4893-9cd8-1b309922b4dc"

# App URL (must match your site for better-auth callbacks)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
