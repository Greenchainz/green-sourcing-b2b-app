# Frontend build context ignore
# Keep the Docker build fast and avoid sending huge folders to the daemon.

# Node / Next artifacts
node_modules
.next
out
dist
coverage

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# Environment files — NEVER send secrets to the build daemon
.env
.env.*
.env.local
.env.production
.env.development

# VCS
.git
.gitignore

# Editor / OS
.vscode
.vs
*.vsidx
*.suo
*.user
.idea
.DS_Store
Thumbs.db

# Tests and docs not needed in the image
**/tests
**/test
**/__tests__
**/*.test.ts
**/*.test.js
**/*.spec.ts
**/*.spec.js
playwright-report

docs
azure
README.md
*.md

# Large data / backup files
*.zip
*.json.bak
materials_all.json
materials_check.json
greenchainz-dev.zip
